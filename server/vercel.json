{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "{src,updates}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/((?!ota/).*)", "destination": "/api" }],
  "headers": [
    {
      "source": "/ota/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
